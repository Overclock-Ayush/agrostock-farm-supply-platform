# Required: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/agrostock?retryWrites=true&w=majority

# Docker Compose uses its own Redis service locally. This value is used for reference.
REDIS_URL=redis://redis:6379

# At least 32 characters. Use a unique random value for deployment.
JWT_SECRET=replace-this-with-a-long-random-secret-32-characters-minimum
JWT_EXPIRATION_MINUTES=120

# Local frontend can be served on http://localhost:5173. Keep http://localhost for optional native runs.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost
APP_SEED_DEMO_DATA=true
