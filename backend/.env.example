# MongoDB Atlas SRV connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/agrostock?retryWrites=true&w=majority

# Local Docker Redis. For deployment, replace with your Upstash rediss:// URL.
REDIS_URL=redis://redis:6379

# At least 32 characters. Generate a new secret for real deployment.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=120

# Comma-separated frontend origins.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost

# Set false after first demo setup if you do not want seeded demo users/products.
APP_SEED_DEMO_DATA=true
